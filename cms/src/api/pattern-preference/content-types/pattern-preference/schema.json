{
  "kind": "collectionType",
  "collectionName": "pattern_preferences",
  "info": {
    "singularName": "pattern-preference",
    "pluralName": "pattern-preferences",
    "displayName": "Muster-Präferenz",
    "description": "Pro Nutzer:in und Muster automatisch gespeicherte Reihen-/Brettchen-Position und Untwist-Modus. Die Highlight-Ein/Aus-Schalter selbst werden bewusst nie gespeichert, nur wo man zuletzt war."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "pattern": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::pattern.pattern",
      "required": true
    },
    "activeRow": {
      "type": "integer",
      "required": true,
      "default": 1,
      "min": 1
    },
    "activeTablet": {
      "type": "integer",
      "required": true,
      "default": 1,
      "min": 1
    },
    "untwistMode": {
      "type": "boolean",
      "required": true,
      "default": false
    }
  }
}
