{
  "kind": "collectionType",
  "collectionName": "collections",
  "info": {
    "singularName": "collection",
    "pluralName": "collections",
    "displayName": "Sammlung",
    "description": "Eine benutzerdefinierte Sammlung von Mustern."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "maxLength": 500
    },
    "visibility": {
      "type": "enumeration",
      "enum": ["private", "public"],
      "required": true,
      "default": "private"
    },
    "isDefault": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "patterns": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::pattern.pattern"
    },
    "subscribers": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user"
    }
  }
}
