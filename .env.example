# --- Vite-Frontend ---
VITE_STRAPI_URL=http://localhost:1337

# --- docker-compose: Postgres ---
POSTGRES_DB=brettchen
POSTGRES_USER=strapi
POSTGRES_PASSWORD=changeme

# --- docker-compose: Strapi-Secrets ---
# Für Produktion neu generieren, siehe cms/.env (von create-strapi-app erzeugt)
# oder: openssl rand -base64 32
APP_KEYS=changeme1,changeme2,changeme3,changeme4
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
ENCRYPTION_KEY=changeme

# Auf true setzen, sobald Strapi hinter TLS/HTTPS läuft (z. B. Reverse-Proxy).
SESSION_COOKIE_SECURE=false

# Von außen erreichbare Frontend-URL - nötig für Strapis CORS (siehe
# cms/config/middlewares.ts). Nur für den Deploy per stack.yml relevant,
# lokal reicht der Default in docker-compose.yml.
CLIENT_URL=https://your-domain.example

# --- docker-compose/stack.yml: SMTP (für "Passwort vergessen") ---
# Ohne SMTP_HOST bleibt das Versenden ein No-op - kein Fehler, es passiert
# einfach nichts. Zugangsdaten beim Mail-Hoster der Domain nachschauen.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=brettchen@krabe.lol
SMTP_REPLY_TO=brettchen@krabe.lol
